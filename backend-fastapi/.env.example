# ParyatakRoute FastAPI Backend Environment Template
# Copy to .env and configure real values. DO NOT commit real secrets.

# Application Configuration
APP_ENV=development
PORT=8000
LOG_LEVEL=INFO
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Supabase Credentials (from Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_min_32_chars

# External Travel API Keys (Optional - free open endpoints used by default)
PLACES_API_KEY=
DIRECTIONS_API_KEY=
WEATHER_API_KEY=
CURRENCY_API_KEY=
EXTERNAL_API_TIMEOUT_SECONDS=8

# AI Provider Configuration (Groq Cloud)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_CHAT_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=30
GROQ_MAX_RETRIES=3
